# Copia este archivo como .env.local y completa con los datos de tu proyecto.
# En Vercel, las mismas variables van en Settings → Environment Variables.

# ── Públicas (viajan al navegador; la seguridad la dan las políticas RLS) ──
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Captcha (opcional) — Cloudflare → Turnstile → Site Key
VITE_TURNSTILE_SITE_KEY=

# ── SECRETAS (solo servidor / tu PC; NUNCA con prefijo VITE_) ──
# Supabase → Project Settings → API → service_role (secret).
# La usan: el respaldo (npm run respaldo) y /api/denunciar (captcha).
SUPABASE_SERVICE_ROLE_KEY=

# Captcha — Cloudflare → Turnstile → Secret Key
TURNSTILE_SECRET_KEY=

# Avisos por Telegram (opcional): ver README
WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
