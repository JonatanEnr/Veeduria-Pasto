# Copia este archivo como .env.local y completa con los datos de tu proyecto:
# Supabase → Project Settings → API (o "Connect" en la parte superior)
#
# La clave "anon / publishable" es PÚBLICA por diseño (viaja al navegador);
# la seguridad la dan las políticas RLS de supabase/esquema.sql.
# NUNCA pongas aquí la clave "service_role" / "secret".

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
